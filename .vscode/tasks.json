{
  "version": "2.0.0",
  "windows": {
    "options": {
      "shell": {
        "executable": "wsl.exe",
        "args": []
      }
    }
  },
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "/usr/bin/g++",
      "args": [
        "-g", 
        "-O0", 
        "-Wall", 
        "-Wextra",
        "test/bftest.c",
        "-o",
        "test/bftest",
        "-I${workspaceFolder}/build/include",
        "-L${workspaceFolder}/build/lib",
        "${workspaceFolder}/build/lib/libssl.a",
        "${workspaceFolder}/build/lib/libcrypto.a"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Generated task by VSCode",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      }
    }
  ]
}